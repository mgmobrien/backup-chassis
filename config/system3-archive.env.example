# Permanent archive configuration for backup-chassis.
#
# Loaded by `system3-backup archive` AFTER the backup env, so anything set here
# overrides the backup values for archive commands only. The archive MUST use a
# different repository from the backup; the runtime refuses to run otherwise.
#
# Archive is on demand and has no retention: things you add stay until you
# delete them yourself. Keep a recovery copy of RESTIC_PASSWORD off this
# machine (password manager); without it the archive is unreadable.

RESTIC_REPOSITORY="s3:s3.us-west-000.backblazeb2.com/example-archive-bucket"
AWS_ACCESS_KEY_ID="example-archive-key-id"
AWS_SECRET_ACCESS_KEY="example-archive-secret-key"
RESTIC_PASSWORD="replace-me"
# Or, on macOS, read secrets from Keychain instead of storing them here:
# AWS_ACCESS_KEY_ID="$(security find-generic-password -a "$USER" -s 'archive-key-id' -w)"
# AWS_SECRET_ACCESS_KEY="$(security find-generic-password -a "$USER" -s 'archive-app-key' -w)"
# RESTIC_PASSWORD="$(security find-generic-password -a "$USER" -s 'archive-repo-password' -w)"

# Optional: separate cache so archive and backup do not share restic cache state.
RESTIC_CACHE_DIR="$HOME/Library/Caches/restic-archive"

SYSTEM3_ARCHIVE_DISPLAY_NAME="Archive"
SYSTEM3_ARCHIVE_STORAGE_LABEL="Backblaze B2 (example-archive-bucket)"
# Defaults: status and manifest live next to the backup status files.
# SYSTEM3_ARCHIVE_STATUS_FILE="$HOME/.local/state/system3-backup/archive-status.json"
# SYSTEM3_ARCHIVE_MANIFEST_FILE="$HOME/.local/state/system3-backup/archive-manifest.jsonl"
# SYSTEM3_ARCHIVE_USE_CAFFEINATE="1"
